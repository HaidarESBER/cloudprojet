# Copier en .env et remplir les valeurs — ne jamais commiter .env !

FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=change-me

# Base de données (SQLite pour dev local, PostgreSQL pour prod)
DATABASE_URL=sqlite:///local_dev.db
# DATABASE_URL=postgresql://pgadmin:password@hostname:5432/flaskdb

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=votre_compte_storage
AZURE_STORAGE_KEY=votre_cle_acces
AZURE_CONTAINER_NAME=static-files
